{
  "config": {
    "MY_CALLSIGN": "AG6AQ",
    "MY_GRID": "CM97",
    "DX_CALLSIGN": "N6HAN",
    "DX_GRID": "CM87",
    "TX_ON_EVEN": true
  },
  "comment": "FreeText is queued through autoseq. It preempts an active QSO once, then the QSO resumes.",
  "periods": [
    {
      "comment": "Period 0 even: empty queue, inject FreeText. It should use fallback parity for the next slot.",
      "messages": [],
      "freetext_event": { "time_offset": 1.0, "text": "TNX 73" }
    },
    {
      "comment": "Period 1 odd: FreeText TX.",
      "messages": []
    },
    {
      "comment": "Period 2 even: FreeText was one-shot and queue is empty.",
      "messages": []
    },
    {
      "comment": "Period 3 odd: DX CQ arrives; touch starts a QSO.",
      "messages": [
        {
          "call_to": "CQ",
          "call_from": "${DX_CALLSIGN}",
          "locator": "${DX_GRID}",
          "snr": -5,
          "slot": 1,
          "freq_hz": 1200
        }
      ],
      "touch_event": { "time_offset": 14.0, "message_index": 0 }
    },
    {
      "comment": "Period 4 even: we TX1 grid to DX.",
      "messages": []
    },
    {
      "comment": "Period 5 odd: inject FreeText while QSO is active. Next TX should be FreeText, not a QSO retry.",
      "messages": [],
      "freetext_event": { "time_offset": 1.0, "text": "HELLO WORLD" }
    },
    {
      "comment": "Period 6 even: FreeText TX preempts QSO retry and is popped after TX.",
      "messages": []
    },
    {
      "comment": "Period 7 odd: DX sends report after receiving our TX1.",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "-12",
          "snr": -12,
          "slot": 1
        }
      ]
    },
    {
      "comment": "Period 8 even: QSO resumes with R+report.",
      "messages": []
    },
    {
      "comment": "Period 9 odd: DX sends 73 and QSO completes.",
      "messages": [
        {
          "call_to": "${MY_CALLSIGN}",
          "call_from": "${DX_CALLSIGN}",
          "locator": "73",
          "snr": -12,
          "slot": 1
        }
      ]
    },
    {
      "comment": "Period 10 even: queue empty.",
      "messages": []
    }
  ]
}
